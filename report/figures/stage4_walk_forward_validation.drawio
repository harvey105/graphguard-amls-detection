        <mxCell id="math_s4_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#0369a1;&quot;&gt;\(\mathcal{T}_{\text{train}} \cap \mathcal{T}_{\text{val}} = \emptyset, \quad \max(t_{\text{train}}) &lt; \min(t_{\text{val}})\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s4_k1" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Anti-Leakage Temporal Order:&lt;/b&gt; Standard randomized K-fold cross-validation is fundamentally flawed for financial graphs, as future edges leak into historical partitions.&lt;br&gt;&amp;bull; &lt;b&gt;Strict Horizon Expansion:&lt;/b&gt; Models train only on historical events up to horizon \(T_k\) and validate on subsequent unobserved windows \((T_k, T_{k+1}]\).&lt;br&gt;&amp;bull; &lt;b&gt;Production Generalization:&lt;/b&gt; Simulates actual enterprise deployment conditions where bank AML models score unseen future transaction streams.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 2: Damped Class Weighting -->
        <mxCell id="s4_kbox_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="915" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s4_k2" value="&lt;b style=&quot;font-size:22px;color:#6d28d9;&quot;&gt;2. Square-Root Damped Class Loss Weighting&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="935" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s4_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#6d28d9;&quot;&gt;\(w_+ = \sqrt{\frac{N_{\text{train}} - P_{\text{train}}}{P_{\text{train}}}}, \quad w_- = 1.0\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="935" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s4_k2" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Failure of Linear Balancing:&lt;/b&gt; In extreme imbalance (\(P \approx 0.1\%\)), standard inverse frequency sets \(w_+ \approx 1000\), creating massive false positive alerts and tree volatility.&lt;br&gt;&amp;bull; &lt;b&gt;Square-Root Heuristic:&lt;/b&gt; Damps the penalty down to \(w_+ \approx \sqrt{1000} \approx 31.6\), providing balanced gradient incentive for Gini impurity splits.&lt;br&gt;&amp;bull; &lt;b&gt;Empirical Stability:&lt;/b&gt; Stabilizes decision boundaries, avoiding alert queue flooding while achieving robust fraud recall across all 3 expanding folds.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="935" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 3: Threshold Optimization -->
        <mxCell id="s4_kbox_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1730" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s4_k3" value="&lt;b style=&quot;font-size:22px;color:#b45309;&quot;&gt;3. Cross-Fold Harmonic Threshold Optimization&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s4_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#b45309;&quot;&gt;\(\theta^* = \arg\max_\theta \frac{1}{K} \sum_{k=1}^K F_1^{(k)}(\theta), \quad F_1 = \frac{2 \cdot P \cdot R}{P + R}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s4_k3" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Harmonic Objective:&lt;/b&gt; Optimizes the threshold \(\theta\) across 12 candidate operating points using cross-fold average \(F_1\) to penalize fold-specific over-tuning.&lt;br&gt;&amp;bull; &lt;b&gt;Optimal Operating Points:&lt;/b&gt; Yields \(\theta^* = 0.70\) for PaySim (&lt;code&gt;without_centrality&lt;/code&gt;) and \(\theta^* = 0.50\) for IBM AML (&lt;code&gt;full_fusion&lt;/code&gt;).&lt;br&gt;&amp;bull; &lt;b&gt;Rule Freezing Gate:&lt;/b&gt; Rules and operating thresholds are cryptographically sealed before the test holdout inference stage is initiated.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption4" value="Stage 4 Architecture: Chronological Walk-Forward Validation across 3 expanding time folds. Uses square-root damped class loss weighting in PySpark MLlib Decision Trees, sweeps 12 threshold operating points, and cryptographically freezes optimal rules before test inference." style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1090" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
