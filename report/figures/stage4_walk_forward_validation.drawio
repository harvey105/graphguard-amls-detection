        <mxCell id="hdr_s4_k1" value="&lt;b style=&quot;font-size:22px;color:#0369a1;&quot;&gt;1. Forward-Chaining Temporal Stability Proof&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
