        <mxCell id="sub_s4_w" value="&lt;div style=&quot;text-align:left;line-height:1.38;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#6d28d9;&quot;&gt;Square-Root Damped Loss Weight:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; \(w_+ = \sqrt{(N_{\text{train}} - P_{\text{train}}) / P_{\text{train}}}, \quad w_- = 1.0\)&lt;br&gt;&amp;bull; Neutralizes 0.10% extreme label rarity&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
