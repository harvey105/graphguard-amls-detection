        <mxCell id="hdr_s3_k1" value="&lt;b style=&quot;font-size:22px;color:#0369a1;&quot;&gt;1. Quantile Scaling &amp;amp; Non-Parametric Normalization&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
