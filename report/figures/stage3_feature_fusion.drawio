        <mxCell id="math_s3_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#0369a1;&quot;&gt;\(\tilde{x}_{\text{amt}} = \frac{x_{\text{amt}}}{q_{90}(x_{\text{amt}} \mid \text{curr}, \text{type})}, \quad \mu_{\text{fold}} \perp \text{Test}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s3_k1" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Heavy-Tailed Financial Skew:&lt;/b&gt; Financial transaction amounts span 7 orders of magnitude ($0.01 to $10,000,000+). Standard z-score scaling collapses under extreme outliers.&lt;br&gt;&amp;bull; &lt;b&gt;90th Percentile Scaling:&lt;/b&gt; Divides by the 90th percentile conditioned on transaction type and currency, preserving relative magnitudes without blowing up tree splits.&lt;br&gt;&amp;bull; &lt;b&gt;Strict Horizon Isolation:&lt;/b&gt; Percentiles are computed exclusively on chronological training prefixes without lookahead into future validation or test periods.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 2: Factorial Ablation Theorem -->
        <mxCell id="s3_kbox_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="915" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s3_k2" value="&lt;b style=&quot;font-size:22px;color:#047857;&quot;&gt;2. Factorial Ablation Decomposition Theorem&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="935" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s3_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#047857;&quot;&gt;\(\Delta F_1(\mathcal{S}) = F_1(\mathcal{F}_{\text{all}}) - F_1(\mathcal{F}_{\text{all}} \setminus \{\mathcal{S}\}), \quad \mathcal{S} \in \{C, M, L\}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="935" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s3_k2" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Controlled Marginal Attribution:&lt;/b&gt; Factorial design isolates the exact marginal gain of centrality (C), motifs (M), and community structure (L) over tabular properties.&lt;br&gt;&amp;bull; &lt;b&gt;Empirical Discovery:&lt;/b&gt; On PaySim, omitting centrality (&lt;code&gt;without_centrality&lt;/code&gt;) boosts test F1 from 31.91% to 36.02% by eliminating hub-induced false positives.&lt;br&gt;&amp;bull; &lt;b&gt;Synergistic Fusion:&lt;/b&gt; On IBM AML, all 4 signal groups (&lt;code&gt;full_fusion&lt;/code&gt;) are required to suppress alert fatigue by -48.3% while maintaining high recall.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="935" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 3: Privacy Allowlist -->
        <mxCell id="s3_kbox_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1730" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s3_k3" value="&lt;b style=&quot;font-size:22px;color:#6d28d9;&quot;&gt;3. Allowlist Privacy &amp;amp; Legal Information Barrier&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s3_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#6d28d9;&quot;&gt;\(\mathcal{F}_{\text{admissible}} \cap \{\text{Raw\_ID}, \text{Comm\_ID}\} = \emptyset, \quad \mathcal{I}(Y; \text{ID}) \to 0\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s3_k3" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Anti-Leakage Governance:&lt;/b&gt; Machine learning models must not memorize historical customer IDs or specific bank account strings, as fraudsters frequently abandon compromised accounts.&lt;br&gt;&amp;bull; &lt;b&gt;Cluster ID Generalization:&lt;/b&gt; Discarding raw LPA cluster IDs ensures models do not memorize training-fold partitions, but instead learn structural sizing and cross-border edge ratios.&lt;br&gt;&amp;bull; &lt;b&gt;Regulatory Alignment:&lt;/b&gt; Enforces GDPR Article 22, FCRA, and Basel Committee standards on explainable, non-discriminatory automated risk decisioning.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption3" value="Stage 3 Architecture: Factorial Feature Fusion pipeline combining Transaction (T), Centrality (C), Motifs (M), and Communities (L) under strict privacy allowlists into unified 32 MiB Snappy Parquet row groups for 9 factorial ablation families." style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1090" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
