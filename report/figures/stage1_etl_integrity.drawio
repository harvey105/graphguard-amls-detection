        <!-- Knowledge Box 1: Vertex Cut vs Edge Cut -->
        <mxCell id="s1_kbox_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s1_k1" value="&lt;b style=&quot;font-size:22px;color:#0369a1;&quot;&gt;1. Vertex Cut vs Edge Cut in Scale-Free Graphs&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s1_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#0369a1;&quot;&gt;\(P(e = (u,v)) = \text{hash}(u, v) \pmod K, \quad \text{Replication Factor} \le 2\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s1_k1" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Power-Law Skew in Banking:&lt;/b&gt; In edge-cut partitioning, high-degree merchant hubs (PaySim in-degree 113) create massive network communication hotspots during iterative joins.&lt;br&gt;&amp;bull; &lt;b&gt;GraphX Vertex Cut Solution:&lt;/b&gt; Assigns edges to partitions using 2D hash routing, cutting high-degree vertices across partitions and routing messages via local vertex mirrors.&lt;br&gt;&amp;bull; &lt;b&gt;Resource Stability:&lt;/b&gt; Prevents single-executor OOM crashes and balances memory commit evenly.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 2: Exact Multiset Reconciliation Protocol -->
        <mxCell id="s1_kbox_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="915" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s1_k2" value="&lt;b style=&quot;font-size:22px;color:#b45309;&quot;&gt;2. Exact Bi-Directional Multiset Invariant Protocol&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="935" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s1_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#b45309;&quot;&gt;\(\Delta_{\text{fwd}} = E_{\text{raw}}.\text{exceptAll}(E_{\text{parquet}}) \equiv \emptyset, \quad \Delta_{\text{rev}} = E_{\text{parquet}}.\text{exceptAll}(E_{\text{raw}}) \equiv \emptyset\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="935" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s1_k2" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Bi-Directional Multiset Difference:&lt;/b&gt; Both forward difference (\(\Delta_{\text{fwd}}\)) and reverse difference (\(\Delta_{\text{rev}}\)) are evaluated across Spark worker nodes.&lt;br&gt;&amp;bull; &lt;b&gt;Cryptographic Row Hash Proof:&lt;/b&gt; Computes 64-bit cryptographic row hashes &lt;code&gt;signed_xxhash64(all_cols)&lt;/code&gt; across CSV and Parquet partitions.&lt;br&gt;&amp;bull; &lt;b&gt;Verification Outcome:&lt;/b&gt; Both counts evaluate to exactly 0, providing mathematical certainty of lossless staging.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="935" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 3: Memory Guard & Windows Mutex -->
        <mxCell id="s1_kbox_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1730" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s1_k3" value="&lt;b style=&quot;font-size:22px;color:#047857;&quot;&gt;3. Memory Guard &amp;amp; Windows Mutex Constraint&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s1_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#047857;&quot;&gt;\(\text{Heap}_{\text{JVM}} \le 5\,\text{GiB}, \quad \text{Commit}_{\text{Host}} \le 8\,\text{GiB}, \quad \text{Mutex}(\text{SparkSession}) = 1\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s1_k3" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Native Hardware Protection:&lt;/b&gt; Native Windows Job Object enforces an 8 GiB Hard Process Cap and 5 GiB JVM Heap limit under strict CPU load.&lt;br&gt;&amp;bull; &lt;b&gt;Parquet Staging Stream:&lt;/b&gt; 32 MiB row-groups enable sequential disk reading without accumulating deserialized objects in RAM.&lt;br&gt;&amp;bull; &lt;b&gt;Workload Concurrency Guard:&lt;/b&gt; Workload lock ensures no concurrent heavy Spark sessions run simultaneously, preventing system thrashing.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption1" value="Stage 1 Architecture: Distributed ETL pipeline with Vertex Cut Partitioning (8 partitions) and 2-way multiset reconciliation gate. The pipeline normalizes bank identifiers, eliminates dangling edges, and stages compact Snappy Parquet files under strict hardware resource limits." style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1090" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>