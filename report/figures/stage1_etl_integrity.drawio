        <mxCell id="sub_s1_strat" value="&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;&lt;b style=&quot;font-size:19px;color:#6d28d9;&quot;&gt;2D Edge Partitioning Strategy:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; \(P(u, v) = \text{hash}(u, v) \pmod 8\)&lt;br&gt;&amp;bull; High-degree vertices cut across partitions&lt;br&gt;&amp;bull; Bounded vertex replication factor \(\le 2\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
