        <mxCell id="sub_s1_chk1" value="&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;&lt;b style=&quot;font-size:19px;color:#b45309;&quot;&gt;Difference Check 1 (Completeness):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; \(\text{Count}(E_{\text{raw}} \setminus E_{\text{parquet}}) \equiv 0\)&lt;br&gt;&amp;bull; Every raw CSV record exists in Parquet&lt;br&gt;&amp;bull; 0 dropped records across all batches&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
