        <mxCell id="t_s1_detail" value="&lt;b style=&quot;font-size:24px;color:#1e40af;&quot;&gt;DISTRIBUTED GRAPH SYSTEMS MECHANICS: RECONCILIATION GATE &amp;amp; PARTITIONING INVARIANTS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
