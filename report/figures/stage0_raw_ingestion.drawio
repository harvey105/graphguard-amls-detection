        <mxCell id="t_s0_detail" value="&lt;b style=&quot;font-size:24px;color:#1e40af;&quot;&gt;DATA CONTRACT SPECIFICATION: MATHEMATICAL INVARIANTS &amp;amp; VERIFICATION SUITE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
