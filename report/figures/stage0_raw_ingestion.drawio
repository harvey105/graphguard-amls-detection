        <!-- Knowledge Box 1: Referential Integrity -->
        <mxCell id="s0_kbox_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s0_k1" value="&lt;b style=&quot;font-size:22px;color:#0369a1;&quot;&gt;1. Referential Integrity &amp;amp; Zero Dangling Invariant&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s0_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#0369a1;&quot;&gt;\(\forall e = (u,v) \in E \implies u \in V \land v \in V, \quad E_{\text{src}} \setminus V = \emptyset \land E_{\text{dst}} \setminus V = \emptyset\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s0_k1" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;GraphFrames RDD Integrity:&lt;/b&gt; Spark GraphX requires every edge endpoint to resolve to a valid vertex row in the underlying RDD partition.&lt;br&gt;&amp;bull; &lt;b&gt;Two-Way Anti-Join Verification:&lt;/b&gt; Automated tests execute left anti-joins &lt;code&gt;E.antiJoin(V, E.src == V.id)&lt;/code&gt; and &lt;code&gt;E.antiJoin(V, E.dst == V.id)&lt;/code&gt;, asserting an exact row count of 0.&lt;br&gt;&amp;bull; &lt;b&gt;Production Crash Prevention:&lt;/b&gt; Eliminates silent JVM null-pointer exceptions and executor task failures during iterative PageRank joins.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 2: Multiset Lossless Pipeline -->
        <mxCell id="s0_kbox_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="915" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s0_k2" value="&lt;b style=&quot;font-size:22px;color:#047857;&quot;&gt;2. Multiset Equality &amp;amp; Lossless Ingestion Theorem&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="935" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s0_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#047857;&quot;&gt;\(\text{Multiset}(E_{\text{raw}}) = \text{Multiset}(E_{\text{parquet}}), \quad E_{\text{raw}} \setminus E_{\text{parquet}} = \emptyset \land E_{\text{parquet}} \setminus E_{\text{raw}} = \emptyset\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="935" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s0_k2" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Bi-Directional Reconciliation:&lt;/b&gt; Proves that ETL transformation drops zero physical transaction records and injects zero duplicate ghost edges.&lt;br&gt;&amp;bull; &lt;b&gt;Exact Audit Match Counts:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; PaySim Match: 6,362,620 raw rows = 6,362,620 parquet rows (0 loss)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; IBM AML Match: 5,078,345 raw rows = 5,078,345 parquet rows (0 loss)&lt;br&gt;&amp;bull; &lt;b&gt;Cryptographic Row Hash Proof:&lt;/b&gt; Every row contains an immutable 64-bit cryptographic hash verifying byte-level fidelity.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="935" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 3: Identity Disambiguation & Privacy (FIXED MATH FORMAT) -->
        <mxCell id="s0_kbox_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1730" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s0_k3" value="&lt;b style=&quot;font-size:22px;color:#b45309;&quot;&gt;3. Bank Disambiguation &amp;amp; Privacy Isolation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s0_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#b45309;&quot;&gt;\(\text{bank\_id} = \text{pad}_3(\text{raw\_id}), \quad \text{id}_{\text{unified}} = \text{bank\_id} \mathbin{\Vert} \text{account\_id}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s0_k3" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;The Bank Normalization Problem:&lt;/b&gt; Raw string IDs without uniform zero-padding caused 515,088 fragmented customer records to be treated as separate external nodes.&lt;br&gt;&amp;bull; &lt;b&gt;Corrected Network Topology:&lt;/b&gt; Restores exactly 518,581 true institutional accounts, correctly reconnecting cross-bank laundering cycles.&lt;br&gt;&amp;bull; &lt;b&gt;Strict Privacy Isolation:&lt;/b&gt; PII and raw account identifiers are strictly quarantined; models only receive topological and behavioral aggregates.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption0" value="Stage 0 Architecture: Multi-format raw data ingestion binding to Graph Data Contracts. Both IBM AML HI-Small and PaySim transaction streams are validated against formal relational invariants ensuring zero dropped records and complete referential integrity." style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1090" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
