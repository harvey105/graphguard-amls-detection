        </mxCell>
        <mxCell id="hdr_tp2_bot" value="&lt;b style=&quot;font-size:26px;color:#0369a1;&quot;&gt;FEATURE ATTRIBUTION &amp;amp; TREE-BASED SPLIT IMPORTANCE DECOMPOSITION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="695" width="1600" height="45" as="geometry" />
        </mxCell>

        <!-- Column 1: Mandatory Factorial Need (Cyan) -->
        <mxCell id="col_tp2_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="755" width="760" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_tp2_k1" value="&lt;b style=&quot;font-size:23px;color:#0369a1;&quot;&gt;1. Mandatory Need for Factorial Ablation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="768" width="720" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_tp2_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#0369a1;&quot;&gt;\(\Delta F_1(\mathcal{S}) = F_1(\mathcal{F}_{\text{all}}) - F_1(\mathcal{F}_{\text{all}} \setminus \mathcal{S}), \quad \mathcal{S} \in \{T, C, M, L\}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="815" width="720" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_tp2_k1" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Anti-Bloat Governance:&lt;/b&gt; Black-box pipelines frequently ingest dozens of overlapping features without verifying incremental utility.&lt;br&gt;&amp;bull; &lt;b&gt;Orthogonal Signal Validation:&lt;/b&gt; Testing all 9 sub-combinations systematically isolates whether graph metrics actually improve fraud detection or simply add compute cost.&lt;br&gt;&amp;bull; &lt;b&gt;Production Efficiency:&lt;/b&gt; Discarding unhelpful signals (e.g. Centrality on PaySim) saves significant GraphFrames cluster execution time.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="905" width="720" height="290" as="geometry" />
        </mxCell>

        <!-- Column 2: PaySim Split Gain Importance (Emerald) -->
        <mxCell id="col_tp2_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="755" width="760" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_tp2_k2" value="&lt;b style=&quot;font-size:23px;color:#047857;&quot;&gt;2. PaySim Split Gain Importance (LightGBM)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="768" width="720" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_tp2_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#047857;&quot;&gt;\(\text{Gain}(M) = 46.5\% \ (\text{receiver\_in\_168h}) + 29.3\% \ (\text{bursts}) = 75.8\%\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="815" width="720" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_tp2_k2" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Dominant Signal:&lt;/b&gt; &lt;code&gt;receiver_in_168h&lt;/code&gt; accounts for &lt;b&gt;46.5%&lt;/b&gt; of total tree split gain, capturing mule accounts aggregating illicit inflows.&lt;br&gt;&amp;bull; &lt;b&gt;Secondary Signal:&lt;/b&gt; &lt;code&gt;scaled_amount&lt;/code&gt; contributes &lt;b&gt;24.2%&lt;/b&gt; of total gain via robust quantile normalizers.&lt;br&gt;&amp;bull; &lt;b&gt;Structural Motifs:&lt;/b&gt; Temporal burst interactions provide the remaining &lt;b&gt;29.3%&lt;/b&gt; of gain, elevating recall by +32.6% over the tabular baseline.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="940" y="905" width="720" height="290" as="geometry" />
        </mxCell>

        <!-- Column 3: IBM AML Multi-Hop Attribution (Amber) -->
        <mxCell id="col_tp2_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1730" y="755" width="770" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_tp2_k3" value="&lt;b style=&quot;font-size:23px;color:#b45309;&quot;&gt;3. IBM AML Multi-Hop Graph Attribution&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="768" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_tp2_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#b45309;&quot;&gt;\(\Phi_{\text{cycle3}} \implies \Delta\text{Prec} = +1.02\%, \quad \Delta\text{Alerts} = -48.3\%\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="815" width="730" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_tp2_k3" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Cycle Participation:&lt;/b&gt; The 3-cycle motif indicator eliminates over 4,600 non-cyclic benign transactions from investigator queues.&lt;br&gt;&amp;bull; &lt;b&gt;PageRank Synergies:&lt;/b&gt; Hub accounts actively participating in cycles receive elevated risk scores, yielding a +1.02% precision boost.&lt;br&gt;&amp;bull; &lt;b&gt;Community Boundary Ratio:&lt;/b&gt; Cross-community edge density from LPA flags smurfing dispersion across disconnected banking networks.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="905" width="730" height="290" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption_tp2" value="Protocol Architecture 2: 9-family factorial ablation matrix. GraphGuard systematically decomposes Tabular, Centrality, Motif, and Community signals, proving that optimal topology is domain-dependent: PaySim thrives on transient burst motifs without centrality, whereas IBM AML requires full 4-way fusion to dismantle complex smurfing rings." style="text;html=1;align=left;verticalAlign=top;fontSize=19;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1265" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
