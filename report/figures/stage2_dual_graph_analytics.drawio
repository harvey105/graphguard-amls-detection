        <mxCell id="sub_s2_fuse2" value="&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;&lt;b style=&quot;font-size:19px;color:#047857;&quot;&gt;32 MiB Disk Cut Staging:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; Writes to Parquet intermediate disk&lt;br&gt;&amp;bull; Avoids in-memory RDD checkpoints&lt;br&gt;&amp;bull; Safe streaming under 5 GiB heap cap&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
