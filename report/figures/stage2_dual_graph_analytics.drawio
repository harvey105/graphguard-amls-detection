        <mxCell id="t_s2_detail" value="&lt;b style=&quot;font-size:24px;color:#1e40af;&quot;&gt;GRAPH ALGORITHMIC FOUNDATION: PAGERANK SINK REPAIR &amp;amp; STRICT-PAST SWEEP-LINE THEOREMS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="605" width="1400" height="40" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 1: Dangling Node Resolution -->
        <mxCell id="s2_kbox_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s2_k1" value="&lt;b style=&quot;font-size:22px;color:#6d28d9;&quot;&gt;1. Dangling Node Resolution &amp;amp; Google Matrix Teleportation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s2_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:19px;color:#6d28d9;&quot;&gt;\(r^{(t+1)}(u) = \frac{1-d}{|V|} + d \left[ \sum_{v \in \mathcal{N}_{\text{in}}(u)} \frac{r^{(t)}(v)}{d_{\text{out}}(v)} + \frac{1}{|V|} \sum_{v \in D} r^{(t)}(v) \right], \quad \sum r(u) = 1.0\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s2_k1" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Sink Trap Phenomenon:&lt;/b&gt; In PaySim, 2,150,401 merchant nodes only receive funds (\(d_{\text{out}} = 0\)). Without teleportation repair, network rank energy leaks to 0.&lt;br&gt;&amp;bull; &lt;b&gt;Dangling Mass Conservation:&lt;/b&gt; The virtual teleportation term \(\frac{1}{|V|} \sum_{v \in D} r(v)\) redistributes dangling mass uniformly, maintaining \(\sum_{u \in V} r(u) = 1.0\).&lt;br&gt;&amp;bull; &lt;b&gt;Spark GraphFrames Fix:&lt;/b&gt; Eliminates NaN float overflows and task crashes during large-scale iterative computation.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 2: Strict As-Of Topological Snapshot Invariant -->
        <mxCell id="s2_kbox_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="915" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s2_k2" value="&lt;b style=&quot;font-size:22px;color:#b45309;&quot;&gt;2. Strict As-Of Topological Snapshot Invariant&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="935" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s2_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:19px;color:#b45309;&quot;&gt;\(T_{\text{snap}} = \max \{ Q_k \mid Q_k &lt; t_i, \; Q_k \in \{20\%, 40\%, 50\%, 65\%, 80\%\} \} \implies \text{Zero Lookahead}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="935" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s2_k2" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;As-Of Lookup Theorem:&lt;/b&gt; Every transaction event at timestamp \(t_i\) is joined strictly with pre-computed snapshot graph \(G_{&lt; t_i}\) where \(T_{\text{snap}} &lt; t_i\).&lt;br&gt;&amp;bull; &lt;b&gt;Zero Future Peeking:&lt;/b&gt; Future edges (\(\ge t_i\)) are mathematically inaccessible during feature extraction, eliminating lookahead bias completely.&lt;br&gt;&amp;bull; &lt;b&gt;Cold-Start Handling:&lt;/b&gt; New nodes entering after \(T_{\text{snap}}\) receive base PageRank \(1/|V|\) and default degree 0 with an active is_new indicator flag.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="935" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 3: Sweep-Line Causal Temporal Motifs -->
        <mxCell id="s2_kbox_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1730" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s2_k3" value="&lt;b style=&quot;font-size:22px;color:#047857;&quot;&gt;3. Sweep-Line Causal Temporal Motifs&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s2_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:19px;color:#047857;&quot;&gt;\(s &lt; t \quad \land \quad 0 &lt; t - s \le W, \quad W \in \{24\text{h}, 168\text{h}\}, \quad \text{Ties } (\Delta t = 0) \text{ decoupled}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s2_k3" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Sliding Causal Horizon:&lt;/b&gt; For any transaction event at timestamp \(t\), queries past events at timestamp \(s\) strictly bounded by \(t - W \le s &lt; t\).&lt;br&gt;&amp;bull; &lt;b&gt;Concurrent Event Tie-Break:&lt;/b&gt; Events with identical timestamp (\(\Delta t = 0\)) cannot form past history for each other, preventing circular causality in batch ETL.&lt;br&gt;&amp;bull; &lt;b&gt;Mule &amp;amp; Smurfing Detection:&lt;/b&gt; 2-hop relay flags fast transfer-to-cashout drains; 3-cycle flags closed circular smurfing paths.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption2" value="Stage 2 Architecture: Dual-Stream Graph Analytics Engines on Apache Spark and GraphFrames. Stream A executes global descriptive graph metrics with sink-safe PageRank (d=0.85) and Synchronous LPA. Stream B compiles strictly causal As-Of quantile snapshots and sweep-line temporal motifs, eliminating future lookahead bias." style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1090" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>