        <mxCell id="sub_leak_thresh" value="&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#047857;&quot;&gt;Threshold Freezing Isolation:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; Decision threshold \(\theta^*\) locked on cross-validation folds&lt;br&gt;&amp;bull; Strictly frozen; never retuned or snooped on test data&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
