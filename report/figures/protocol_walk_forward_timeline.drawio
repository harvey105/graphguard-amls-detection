        <mxCell id="sub_ties_ord" value="&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#b45309;&quot;&gt;Deterministic Timestamp Ordering:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; Edges with identical timestamp (\(\Delta t = 0\)) ordered by:&lt;br&gt;&amp;bull; Tuple \((t, \text{hash}(\text{src}), \text{hash}(\text{dst}), \text{amt})\) uniquely&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="195" width="530" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sub_ties_cold" value="&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#b45309;&quot;&gt;Cold-Start Node Regularization:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; New test accounts without past transaction history&lt;br&gt;&amp;bull; Receive prior base PageRank \(1/|\mathcal{V}|\) and degree 0&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="325" width="530" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sub_ties_sync" value="&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#b45309;&quot;&gt;LPA Deterministic Tie-Breaking:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; Ties broken deterministically via \(\min(\text{signed\_xxhash64})\)&lt;br&gt;&amp;bull; Eliminates multi-threading race conditions across nodes&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
