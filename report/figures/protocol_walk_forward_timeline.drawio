        <mxCell id="hdr_tp1_snap" value="&lt;b style=&quot;font-size:24px;color:#6d28d9;&quot;&gt;2. CAUSAL GRAPH SNAPSHOTS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#7c3aed;font-weight:400;&quot;&gt;Strict-Past Topological State Isolation&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="690" y="135" width="570" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sub_snap_form" value="&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#6d28d9;&quot;&gt;Formal As-Of Graph Definition:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; \(\mathcal{G}_{&lt; t} = (\mathcal{V}_{&lt; t}, \mathcal{E}_{&lt; t})\) where \(\mathcal{E}_{&lt; t} = \{e \in \mathcal{E} \mid t_e &lt; t\}\)&lt;br&gt;&amp;bull; Target edge \(e_t\) and all future edges are strictly unseen&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="710" y="195" width="530" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sub_snap_algo" value="&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#6d28d9;&quot;&gt;Algorithm Invariant Execution:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; PageRank &amp;amp; LPA execute solely on historical \(\mathcal{E}_{&lt; t}\)&lt;br&gt;&amp;bull; Degree and motif counters look strictly backwards&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="710" y="325" width="530" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sub_snap_win" value="&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#6d28d9;&quot;&gt;Causal Rolling Windows:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; Windows \(W \in \{1\text{h}, 24\text{h}, 168\text{h}\}\) bounded: \(t - W \le s &lt; t\)&lt;br&gt;&amp;bull; Strictly prevents self-target feedback &amp;amp; label leakage&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="710" y="455" width="530" height="115" as="geometry" />
        </mxCell>
