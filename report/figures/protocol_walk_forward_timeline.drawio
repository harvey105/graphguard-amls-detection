        <mxCell id="hdr_tp1_ties" value="&lt;b style=&quot;font-size:24px;color:#b45309;&quot;&gt;3. TIE-BREAKING &amp;amp; COLD START&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#d97706;font-weight:400;&quot;&gt;Microsecond Collision &amp;amp; Node Regularization&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
