        <!-- Column 1: Temporal Inversion Failure (Cyan) -->
        <mxCell id="col_tp1_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="755" width="760" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_tp1_k1" value="&lt;b style=&quot;font-size:23px;color:#0369a1;&quot;&gt;1. Temporal Inversion in Random K-Fold&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="768" width="720" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_tp1_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#0369a1;&quot;&gt;\(\mathbb{P}(\text{Leakage} \mid \text{Random Split}) = 1.0, \quad t_{\text{train}} &gt; t_{\text{test}}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="815" width="720" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_tp1_k1" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;The Anachronism Trap:&lt;/b&gt; Random splitting places future transaction \(t_2\) in training and past transaction \(t_1\) (\(t_1 &lt; t_2\)) in testing.&lt;br&gt;&amp;bull; &lt;b&gt;Bidirectional Graph Contamination:&lt;/b&gt; PageRank and LPA computed on the full graph leak future money laundering signals backwards into the past.&lt;br&gt;&amp;bull; &lt;b&gt;Catastrophic Real-World Collapse:&lt;/b&gt; Models reporting 0.99 AUC in randomized lab splits drop below 0.50 AUC in live banking due to broken causal ordering.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="905" width="720" height="290" as="geometry" />
        </mxCell>

        <!-- Column 2: Expanding Walk-Forward Architecture (Purple) -->
        <mxCell id="col_tp1_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="755" width="760" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_tp1_k2" value="&lt;b style=&quot;font-size:23px;color:#6d28d9;&quot;&gt;2. Expanding-Window Walk-Forward Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="768" width="720" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_tp1_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#6d28d9;&quot;&gt;\(\mathcal{T}_{\text{train}}^{(k)} = [0, T_k], \quad \mathcal{T}_{\text{val}}^{(k)} = (T_k, T_{k+1}], \quad \mathcal{T}_{\text{train}} \cap \mathcal{T}_{\text{val}} = \emptyset\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="815" width="720" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_tp1_k2" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#4c1d95;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Production Realism:&lt;/b&gt; In live banking, an institution only possesses transactions up to \(T_k\). Models must be evaluated strictly on the subsequent block \((T_k, T_{k+1}]\).&lt;br&gt;&amp;bull; &lt;b&gt;Cumulative Knowledge Retention:&lt;/b&gt; Expanding prefixes (\(\le 40\% \to \le 50\% \to \le 65\%\)) allow models to accumulate graph topology while adapting to drift.&lt;br&gt;&amp;bull; &lt;b&gt;True Out-of-Time Generalization:&lt;/b&gt; Validation metrics accurately reflect future production capability without retrospective bias.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="940" y="905" width="720" height="290" as="geometry" />
        </mxCell>

        <!-- Column 3: Formal As-Of Graph Proof (Emerald) -->
        <mxCell id="col_tp1_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1730" y="755" width="770" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_tp1_k3" value="&lt;b style=&quot;font-size:23px;color:#047857;&quot;&gt;3. Formal As-Of Graph Construction Proof&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="768" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_tp1_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#047857;&quot;&gt;\(\mathbf{x}_i = f(e_i,\, \mathcal{G}_{&lt; t_i}), \quad \text{burst}_W(u, t_i) = \sum_{e \in \mathcal{E}, \text{src}=u} \mathbb{I}(t_i - W \le t_e &lt; t_i)\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="815" width="730" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_tp1_k3" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Strict-Past Invariant:&lt;/b&gt; For any transaction \(e_i = (u, v, t_i)\), its feature vector \(\mathbf{x}_i\) satisfies \(\mathbf{x}_i = f(e_i, \mathcal{G}_{&lt; t_i})\) where \(\mathcal{G}_{&lt; t_i} = (\mathcal{V}, \{e \in \mathcal{E} \mid t_e &lt; t_i\})\).&lt;br&gt;&amp;bull; &lt;b&gt;Causal Window Summation:&lt;/b&gt; The strict upper bound \(t_e &lt; t_i\) prevents self-target feedback, ensuring current transaction attributes never corrupt history.&lt;br&gt;&amp;bull; &lt;b&gt;Audit Invariance:&lt;/b&gt; Any independent regulator can replay the event log chronologically and obtain byte-for-byte identical feature states.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="905" width="730" height="290" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption_tp1" value="Protocol Architecture 1: Expanding-window walk-forward timeline. Unlike randomized cross-validation which fatally leaks future network topologies into past evaluations, GraphGuard enforces strict-past causal boundaries (\(t_e &lt; t_i\)) and 3 expanding validation folds, guaranteeing reliable, uninflated out-of-time production metrics." style="text;html=1;align=left;verticalAlign=top;fontSize=19;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1265" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
