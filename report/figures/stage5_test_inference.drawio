        <!-- Knowledge Box 1: Compliance Economics -->
        <mxCell id="s5_kbox_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s5_k1" value="&lt;b style=&quot;font-size:22px;color:#b45309;&quot;&gt;1. Banking Compliance Cost Relief Economics&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s5_k1" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#b45309;&quot;&gt;\(\Delta_{\text{Ops}} = -4,628\,\text{Alerts} \times \$75/\text{FTE} \approx \$347,100\,\text{Direct Savings}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s5_k1" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;The False Positive Crisis:&lt;/b&gt; Over 90% of alerts produced by traditional legacy rule-based AML systems are false positives, causing massive investigator fatigue.&lt;br&gt;&amp;bull; &lt;b&gt;48.3% Alert Queue Reduction:&lt;/b&gt; GraphGuard cuts total alert investigations from 9,584 down to 4,956 on 1.01M IBM AML holdout transactions.&lt;br&gt;&amp;bull; &lt;b&gt;Direct Cost Savings:&lt;/b&gt; At an industry average cost of $75 per compliance review, this reduction yields $347,100 in direct operational savings per reporting cycle.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 2: Fraud Interception -->
        <mxCell id="s5_kbox_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="915" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s5_k2" value="&lt;b style=&quot;font-size:22px;color:#047857;&quot;&gt;2. PaySim Direct Fraud Loss Interception Value&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="935" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s5_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#047857;&quot;&gt;\(\Delta_{\text{Fraud}} = +273\,\text{Frauds Caught} \times \$260,000/\text{Tx} \approx \$70.98\text{M Saved}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="935" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s5_k2" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;High-Stakes Mobile Fraud:&lt;/b&gt; In PaySim, fraudulent transactions involve rapid, complete account drainage via paired TRANSFER and CASH_OUT mechanisms.&lt;br&gt;&amp;bull; &lt;b&gt;+32.6% Relative Recall Lift:&lt;/b&gt; Elevates captured fraud cases from 836 (baseline) to 1,109 (GraphGuard), recovering 273 additional laundering schemes.&lt;br&gt;&amp;bull; &lt;b&gt;Direct Loss Prevention:&lt;/b&gt; With an average fraud transaction value of $260,000, intercepting 273 additional events prevents ~$70.98M in capital loss.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="935" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Knowledge Box 3: Wilson Confidence Bounds -->
        <mxCell id="s5_kbox_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1730" y="655" width="770" height="395" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s5_k3" value="&lt;b style=&quot;font-size:22px;color:#0369a1;&quot;&gt;3. Wilson 95% Score Confidence Interval Formulation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="668" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s5_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:20px;color:#0369a1;&quot;&gt;\(\text{CI}_{95\%} = \frac{\hat{p} + \frac{z^2}{2n} \pm z\sqrt{\frac{\hat{p}(1-\hat{p})}{n} + \frac{z^2}{4n^2}}}{1 + \frac{z^2}{n}}, \quad z = 1.96\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="710" width="730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="desc_s5_k3" value="&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Asymmetric Binomial Estimation:&lt;/b&gt; In extreme class imbalance, standard normal Wald approximations produce invalid negative lower bounds or zero widths.&lt;br&gt;&amp;bull; &lt;b&gt;Wilson Score Method:&lt;/b&gt; Corrects skewness for rare proportions, providing exact 95% confidence intervals on out-of-time test performance.&lt;br&gt;&amp;bull; &lt;b&gt;Verified Lift Significance:&lt;/b&gt; Proves IBM precision lift ([9.28%, 10.96%]) is statistically superior to baseline (9.07%), confirming model generalizability.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="780" width="730" height="250" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption5" value="Stage 5 Architecture: Frozen test holdout evaluation across 2.27M unseen transactions. Achieves -48.3% alert fatigue reduction on IBM AML and +32.6% fraud recall lift on PaySim, verified by 95% Wilson confidence intervals across 5 out-of-time intervals." style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1090" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
