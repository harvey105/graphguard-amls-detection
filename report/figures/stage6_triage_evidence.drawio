          <mxGeometry x="120" y="815" width="720" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_s6_k1" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#0c4a6e;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Fixed Headcount Constraint:&lt;/b&gt; Financial compliance units have fixed FTE investigator capacity and cannot review unranked alert queues exceeding staffing thresholds.&lt;br&gt;&amp;bull; &lt;b&gt;Top-K Capacity Slicing:&lt;/b&gt; Maps alert generation directly to review capacity budgets (0.1%, 0.5%, 1.0%), guaranteeing high precision in operational queues.&lt;br&gt;&amp;bull; &lt;b&gt;72.06% Precision Hit Rate:&lt;/b&gt; In the Top-0.1% budget, nearly 3 out of every 4 reviewed transactions are confirmed fraudulent, eliminating wasted analyst hours.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="905" width="720" height="290" as="geometry" />
        </mxCell>

        <!-- Column 2: SAR/STR Witness Structure (Amber) -->
        <mxCell id="col_s6_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="755" width="760" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s6_k2" value="&lt;b style=&quot;font-size:23px;color:#b45309;&quot;&gt;2. Suspicious Transaction Report (SAR/STR) Witness Format&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="768" width="720" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s6_k2" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#b45309;&quot;&gt;\(\mathcal{W}_{\text{SAR}} = \{e_t,\, \mathcal{G}_{\text{sub}}^{(k)},\, \text{Path}(u \to \dots \to v),\, \Delta\tau,\, \Phi_{\text{motif}}\}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="815" width="720" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_s6_k2" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#78350f;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Evidentiary Admissibility:&lt;/b&gt; Black-box probability scores are legally insufficient for filing Suspicious Activity Reports (SAR/STR) with regulatory authorities.&lt;br&gt;&amp;bull; &lt;b&gt;Deterministic Subgraph Payloads:&lt;/b&gt; GraphGuard packages the full directed topological path, transaction velocity (\(\Delta\tau\)), amounts, and motif roles.&lt;br&gt;&amp;bull; &lt;b&gt;Audit Admissibility:&lt;/b&gt; Delivers concrete structural evidence (e.g. 3-cycle circular smurfing paths, rapid mule draining) ready for judicial prosecution.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="940" y="905" width="720" height="290" as="geometry" />
        </mxCell>

        <!-- Column 3: Wilson Uncertainty Bounds (Emerald) -->
        <mxCell id="col_s6_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1730" y="755" width="770" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s6_k3" value="&lt;b style=&quot;font-size:23px;color:#047857;&quot;&gt;3. Wilson Uncertainty Bounds in Production Governance&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1750" y="768" width="730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="math_s6_k3" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;font-size:24px;color:#047857;&quot;&gt;\(\hat{p}_{\text{lower}} = \frac{\hat{p} + \frac{z^2}{2n} - z\sqrt{\frac{\hat{p}(1-\hat{p})}{n} + \frac{z^2}{4n^2}}}{1 + \frac{z^2}{n}} &gt; \theta_{\text{regulatory}}\)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="815" width="730" height="75" as="geometry" />
        </mxCell>
        <mxCell id="desc_s6_k3" value="&lt;div style=&quot;text-align:left;line-height:1.6;&quot;&gt;&lt;span style=&quot;font-size:18px;color:#064e3b;font-weight:400;&quot;&gt;&amp;bull; &lt;b&gt;Statistical Risk Governance:&lt;/b&gt; Financial regulators require proof that model performance is not an artifact of small sample sizes or lucky test intervals.&lt;br&gt;&amp;bull; &lt;b&gt;Conservative Risk Guarantees:&lt;/b&gt; Operating queues are governed by the lower 95% Wilson confidence bound (\(\hat{p}_{\text{lower}}\)) to guarantee minimum compliance performance.&lt;br&gt;&amp;bull; &lt;b&gt;End-to-End System Integrity:&lt;/b&gt; Assures financial executives and external regulators of mathematical rigor across the entire AML pipeline.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1750" y="905" width="730" height="290" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption6" value="Stage 6 Architecture: Production AML Triage with capacity-constrained review budgets (Top 0.1%, 0.5%, 1.0%), producing forensic subgraph evidence witnesses for Suspicious Transaction Reports (STR/SAR) and meeting Federal Reserve SR 11-7 and FATF governance standards." style="text;html=1;align=left;verticalAlign=top;fontSize=19;fontColor:#334155;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="1265" width="2460" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
